{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glossmark",
  "version": "0.1.0",
  "identifier": "io.github.nuncaeslupus.glossmark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Glossmark", "width": 1000, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' image: http://image.localhost data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown document", "mimeType": "text/markdown", "role": "Viewer" }
    ],
    "shortDescription": "A Markdown viewer that reads like a well-typeset document",
    "macOS": { "signingIdentity": "-" },
    "linux": {
      "deb": { "desktopTemplate": "linux/glossmark.desktop" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMEFDMUE2RjYyRDY3OEQKUldTTlp5MzJwc0VLYi9tUW9acncva1BHOVVKQTJlZ3VxTEM0VXp0QThaSVBEenMwNExmY2dFaEkK",
      "endpoints": ["https://github.com/nuncaeslupus/glossmark/releases/latest/download/latest.json"]
    }
  }
}
